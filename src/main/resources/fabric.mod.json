{
  "schemaVersion": 1,
  "id": "lidlclient",
  "version": "${version}",
  "name": "Lidl Client",
  "description": "Client-side quality-of-life features, dungeon maps and visual customisation.",
  "authors": [
    "Me!"
  ],
  "contact": {
    "sources": "https://github.com/amlox/lidlclient"
  },
  "license": "CC0-1.0",
  "icon": "assets/lidlclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.lidl.lidlclient.PartyCMDS.PartyCommands",
      "net.lidl.lidlclient.slots.Slots",
      "net.lidl.lidlclient.gui.ModuleFramework",
      "net.lidl.lidlclient.commands.WarpCommands",
      "net.lidl.lidlclient.hotbar.DungeonbreakerSwap",
      "net.lidl.lidlclient.pets.ZeroPingPets",
      "net.lidl.lidlclient.size.PlayerSize",
      "net.lidl.lidlclient.dungeons.DungeonMap"
    ]
  },
  "mixins": [
    "lidlclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
